# No se usa directamente por Dokploy (las variables se configuran en el
# panel de la aplicación Compose), pero sirve como referencia de qué
# variables necesita este servicio, y para pruebas locales con
# `docker compose up` si alguna vez quieres correrlo en tu máquina.
#
# Copia este archivo a `.env` (NO lo subas a git) y rellena los valores
# reales si vas a levantarlo localmente.

# API key de Anthropic — console.anthropic.com
# Usada por Graphiti para extraer entidades/hechos de las conversaciones.
ANTHROPIC_API_KEY=

# API key de Voyage AI — voyageai.com (tiene capa gratuita)
# Usada por Graphiti para generar los embeddings del grafo.
VOYAGE_API_KEY=

# Contraseña de FalkorDB (opcional pero recomendada si el servicio queda
# expuesto en una red no controlada).
FALKORDB_PASSWORD=

# Namespace de los hechos guardados en el grafo. Por defecto
# "jesus-cristancho" (ver docker-compose.yml) si lo dejas vacío.
GRAPHITI_GROUP_ID=

# Modelo de Anthropic a usar para la extracción. Por defecto
# claude-sonnet-4-5 si lo dejas vacío.
MODEL_NAME=
